# GitHub Configuration
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username

# OpenRouter AI Configuration
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Database Configuration
DATABASE_URL=sqlite:///gitintellisense.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/gitintellisense.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Rate Limiting Configuration
GITHUB_RATE_LIMIT_PER_HOUR=4500
OPENROUTER_RATE_LIMIT_PER_MINUTE=60
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2

# Analysis Configuration
MAX_REPOSITORIES_PER_SCAN=10
MAX_COMMITS_TO_ANALYZE=1000
MAX_ISSUES_TO_ANALYZE=500
ANALYSIS_CACHE_TTL=3600

# AI Configuration
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4000
AI_TOP_P=0.9
AI_FREQUENCY_PENALTY=0.1
AI_PRESENCE_PENALTY=0.1

# Contribution Configuration
MIN_CONTRIBUTION_SCORE=0.7
MAX_CONTRIBUTIONS_PER_DAY=3
CONTRIBUTION_VALIDATION_ENABLED=true
DRY_RUN_MODE=true

# Security Configuration
ENCRYPT_SENSITIVE_DATA=true
ENCRYPTION_KEY=your_32_character_encryption_key_here
SESSION_TIMEOUT=3600
API_KEY_ROTATION_DAYS=90

# Performance Configuration
ASYNC_WORKER_COUNT=10
CACHE_SIZE=1000
MEMORY_LIMIT_MB=2048
CPU_LIMIT_PERCENT=80

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=8080
HEALTH_CHECK_INTERVAL=60
ALERT_WEBHOOK_URL=https://your-webhook-url.com/alerts

# Development Configuration
DEBUG=false
DEVELOPMENT_MODE=false
PROFILING_ENABLED=false
VERBOSE_LOGGING=false

# Target Repository Configuration
DEFAULT_TARGET_REPO=bitcoin/bitcoin
TARGET_BRANCHES=master,main,develop
EXCLUDE_PATHS=.git,.github,node_modules,__pycache__
INCLUDE_FILE_EXTENSIONS=.py,.cpp,.h,.js,.ts,.md

# Notification Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/your/webhook/url
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=backups/

# Feature Flags
ENABLE_AI_ANALYSIS=true
ENABLE_STATIC_ANALYSIS=true
ENABLE_PATTERN_RECOGNITION=true
ENABLE_CONTRIBUTION_GENERATION=true
ENABLE_AUTOMATED_TESTING=true
ENABLE_PERFORMANCE_MONITORING=true
